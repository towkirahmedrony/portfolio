NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
GEMINI_API_KEY=your-gemini-api-key

# Model used by /api/ai/chat. Must stay a current, supported Gemini model.
GEMINI_MODEL=gemini-3.6-flash

# Thinking level for the model. gemini-3.6-flash defaults to "medium", which
# dominates time-to-first-token for a FAQ-style assistant, so this project pins
# "low". Accepted: minimal | low | medium | high. Use "off" (or none/default)
# to let the model decide. If the configured model rejects the parameter the
# request is retried once without it.
GEMINI_THINKING_LEVEL=low

# Override only for local testing against a mock Gemini endpoint.
# Leave unset in production.
# GEMINI_API_ORIGIN=https://generativelanguage.googleapis.com/v1beta
