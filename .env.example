NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Dify chatflow API called by POST /api/ai/chat. The website is only a bridge
# between the chat UI and Dify: the model, Nora's instructions and the live
# Supabase business context all live in Dify (its HTTP Request node calls
# /api/ai/context).
#
# Base URL only, WITHOUT the /chat-messages path, e.g. https://api.dify.ai/v1
# for Dify Cloud or https://your-dify-host/v1 for a self-hosted install.
DIFY_API_URL=your-dify-api-url

# Server-only Dify app API key (Dify: app -> API Access -> API Key). Sent as
# `Authorization: Bearer <key>`. Never expose this to the browser and never
# prefix it with NEXT_PUBLIC_. This is NOT the same secret as
# DIFY_CONTEXT_SECRET below, which authenticates Dify calling us.
DIFY_API_KEY=your-dify-api-key

# ---------------------------------------------------------------------------
# Legacy: the direct Gemini integration was replaced by Dify. src/lib/ai/gemini.ts
# is kept on disk pending verification, so these stay documented, but nothing
# under /api/ai/chat or /api/ai/context reads them any more.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# Model used by the legacy Gemini module. Must stay a current, supported model.
GEMINI_MODEL=gemini-3.6-flash

# Thinking level for the model. gemini-3.6-flash defaults to "medium", which
# dominates time-to-first-token for a FAQ-style assistant, so this project pins
# "low". Accepted: minimal | low | medium | high. Use "off" (or none/default)
# to let the model decide. If the configured model rejects the parameter the
# request is retried once without it.
GEMINI_THINKING_LEVEL=low

# Override only for local testing against a mock Gemini endpoint.
# Leave unset in production.
# GEMINI_API_ORIGIN=https://generativelanguage.googleapis.com/v1beta

# Server-to-server secret for POST /api/ai/context, which Dify calls before the
# Nora LLM step. Dify sends it as the X-Dify-Context-Secret header (an
# `Authorization: Bearer <secret>` header also works). Server-only: never expose
# this to the browser and never prefix it with NEXT_PUBLIC_. Generate a long
# random value, e.g. `openssl rand -hex 32`. If it is unset the endpoint
# rejects every request with 401.
DIFY_CONTEXT_SECRET=your-dify-context-secret
